# ============================================================
# .env.example — HelpDesk Buritis
# Copie para `.env` e preencha com os valores do seu backend.
#   cp .env.example .env
# ============================================================

# ---- Porta da aplicação na VPS ----
APP_PORT=3000

# ---- Variáveis PÚBLICAS (embutidas no bundle do cliente) ----
# Prefixo VITE_ é exposto ao navegador. Use SEMPRE a anon/publishable key aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=seu-project-id

# ---- Variáveis de SERVIDOR (SSR / server functions) ----
# Nunca expostas ao navegador. A service role key BYPASSA o RLS — mantenha secreta.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- PostgreSQL local (opcional, serviço `db` do docker-compose) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=helpdesk
DB_PORT=5432
